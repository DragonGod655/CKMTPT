# Cấu hình API cho Chatbot
# Khuyên dùng: Google Gemini (tạo khóa miễn phí tại Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Hoặc dùng OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Backend public, nếu triển khai riêng:
# CHAT_ALLOWED_ORIGIN=https://dragongod655.github.io
# PORT=8787
# Cấu hình khi build giao diện để dùng backend public:
# VITE_CHAT_API_URL=https://your-backend.example/api/chat
